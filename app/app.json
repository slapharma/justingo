{
  "expo": {
    "name": "JustinGo",
    "slug": "justingo",
    "scheme": "justingo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.justingo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "JustinGo uses your location to give you turn-by-turn voice directions along your route.",
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "package": "com.justingo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF5F1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font"],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/app"
    }
  }
}
